#: nectar/customizer/panels/general-settings.php:406
msgid "Form Input Field Text Size"
msgstr "Размер текста поля ввода формы"

#: nectar/customizer/panels/general-settings.php:407
msgid "Alters the font size for form input field/textarea elements."
msgstr "Изменяет размер шрифта для полей ввода формы и элементов textarea."

#: nectar/customizer/panels/general-settings.php:418
msgid "Form Input Field Padding"
msgstr "Отступы поля ввода формы"

#: nectar/customizer/panels/general-settings.php:419
