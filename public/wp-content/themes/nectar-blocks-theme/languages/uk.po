msgstr "Стилізація кнопок"

#: nectar/customizer/panels/general-settings.php:119
msgid "This will effect the overall styling of buttons"
msgstr "Це вплине на загальний стиль кнопок"

#: nectar/customizer/panels/general-settings.php:122
msgid "Slightly Rounded"
msgstr "Злегка заокруглений"

#: nectar/customizer/panels/general-settings.php:123
