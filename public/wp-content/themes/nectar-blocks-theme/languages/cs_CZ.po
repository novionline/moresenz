msgstr "Upravuje velikost písma pro vstupní pole formuláře a prvky textarea."

#: nectar/customizer/panels/general-settings.php:418
msgid "Form Input Field Padding"
msgstr "Odsazení vstupního pole formuláře"

#: nectar/customizer/panels/general-settings.php:419
msgid "Fine-tune form input fields/textarea element padding."
