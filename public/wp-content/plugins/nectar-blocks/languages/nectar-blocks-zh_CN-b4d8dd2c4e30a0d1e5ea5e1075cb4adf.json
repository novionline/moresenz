 to check for updates.":["\u68c0\u67e5\u66f4\u65b0\u65f6\u51fa\u9519\u3002"],"CSS":["CSS"],"Custom JS\/HTML":["\u81ea\u5b9a\u4e49 JS\/HTML"],"Custom CSS":["\u81ea\u5b9a\u4e49 CSS"],"Custom Code (JS\/HTML) in Head":["Head \u4e2d\u7684\u81ea\u5b9a\u4e49\u4ee3\u7801 (JS\/HTML)"],"If using JS, ensure to include script tags.":["\u5982\u679c\u4f7f\u7528 JS\uff0c\u8bf7\u786e\u4fdd\u5305\u542b script \u6807\u7b7e\u3002"],"Custom Code (JS\/HTML) After Body Open":["Body \u6807\u7b7e\u540e\u7684\u81ea\u5b9a\u4e49\u4ee3\u7801 (JS\/HTML)"],"Add a New Font":["\u6dfb\u52a0\u65b0\u5b57\u4f53"],"Please enter a font name.":["\u8bf7\u8f93\u5165\u5b57\u4f53\u540d\u79f0\u3002"],"Failed to update custom font.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u66f4\u65b0\u5931\u8d25\u3002"],"Successfully updated custom font.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u66f4\u65b0\u6210\u529f\u3002"],"Add Font":["\u6dfb\u52a0\u5b57\u4f53"],"No changes were made.":["\u672a\u505a\u4efb\u4f55\u66f4\u6539\u3002"],"Failed to update custom font variation.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u53d8\u4f53\u66f4\u65b0\u5931\u8d25\u3002"],"Successfully updated custom font variation.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u53d8\u4f53\u66f4\u65b0\u6210\u529f\u3002"],"Update Font Data":["\u66f4\u65b0\u5b57\u4f53\u6570\u636e"],"Failed to delete custom font variation":["\u5220\u9664\u81ea\u5b9a\u4e49\u5b57\u4f53\u53d8\u4f53\u5931\u8d25"],"Successfully deleted custom font variation.":["\u6210\u529f\u5220\u9664\u81ea\u5b9a\u4e49\u5b57\u4f53\u53d8\u4f53\u3002"],"Delete":["\u5220\u9664"],"Failed to delete custom font.":["\u5220\u9664\u81ea\u5b9a\u4e49\u5b57\u4f53\u5931\u8d25\u3002"],"Successfully deleted custom font.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u5df2\u6210\u529f\u5220\u9664\u3002"],"Add a Font Variation":["\u6dfb\u52a0\u5b57\u4f53\u53d8\u4f53"],"Choose a .ttf, .woff, or .woff2 file":["\u9009\u62e9\u4e00\u4e2a .ttf\u3001.woff \u6216 .woff2 \u6587\u4ef6"],"Please select a file to import.":["\u8bf7\u9009\u62e9\u8981\u5bfc\u5165\u7684\u6587\u4ef6\u3002"],"Successfully custom font.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u6210\u529f\u3002"],"Failed to import custom font.":["\u81ea\u5b9a\u4e49\u5b57\u4f53\u5bfc\u5165\u5931\u8d25\u3002"],"Import":["\u5bfc\u5165"],"Welcome to the future of WordPress":["\u6b22\u8fce\u6765\u5230 WordPress \u7684\u672a\u6765"],"Nectarblocks elevates the WordPress Gutenberg editor to an exceptionally powerful editor. Explore the key features below to begin your journey.":["Nectarblocks\u5c06WordPress Gutenberg\u7f16\u8f91\u5668\u63d0\u5347\u81f3\u4e00\u4e2a\u975e\u5e38\u5f3a\u5927\u7684\u7f16\u8f91\u5668\u6c34\u5e73\u3002\u63a2\u7d22\u4ee5\u4e0b\u4e3b\u8981\u529f\u80fd\uff0c\u5f00\u542f\u60a8\u7684\u4f7f\u7528\u4e4b\u65c5\u3002"],"Block Collection":["Block \u96c6\u5408"],"A robust collection of powerful blocks designed to simplify the process of building your website.":["\u4e00\u5957\u529f\u80fd\u5f3a\u5927\u7684 blocks \u96c6\u5408\uff0c\u65e8\u5728\u7b80\u5316\u60a8\u7684\u7f51\u7ad9\u6784\u5efa\u8fc7\u7a0b\u3002"],"The Template Library":["Template \u6a21\u677f\u5e93"],"Jump start your Website creation with our professionally designed collection of pre-made templates":["\u4f7f\u7528\u6211\u4eec\u4e13\u4e1a\u8bbe\u8ba1\u7684\u9884\u5236\u6a21\u677f\u96c6\u5408\uff0c\u5feb\u901f\u542f\u52a8\u60a8\u7684\u7f51\u7ad9\u521b\u5efa"],"Streamlined Global Settings":["\u5168\u5c40\u8bbe\u7f6e\u4f18\u5316"],"Establish reusable color schemes and typography rules that can be effortlessly applied to Nectar blocks across all your pages.":["\u5efa\u7acb\u53ef\u91cd\u590d\u4f7f\u7528\u7684\u914d\u8272\u65b9\u6848\u548c\u6392\u7248\u89c4\u5219\uff0c\u53ef\u4ee5\u8f7b\u677e\u5730\u5e94\u7528\u5230\u6240\u6709\u9875\u9762\u7684 Nectar blocks \u4e2d\u3002"],"Extensively Customizable Block Settings":["\u53ef\u5e7f\u6cdb\u81ea\u5b9a\u4e49\u7684 Block \u8bbe\u7f6e"],"Experience unparalleled control with our extensively customizable block settings. Tailor each element to your unique design requirements.":["\u901a\u8fc7\u6211\u4eec\u9ad8\u5ea6\u53ef\u5b9a\u5236\u7684 block \u8bbe\u7f6e\uff0c\u4f53\u9a8c\u65e0\u4e0e\u4f26\u6bd4\u7684\u63a7\u5236\u529b\u3002\u6839\u636e\u60a8\u72ec\u7279\u7684\u8bbe\u8ba1\u9700\u6c42\u5b9a\u5236\u6bcf\u4e2a\u5143\u7d20\u3002"],"Next-Gen Responsive Editing":["\u65b0\u4e00\u4ee3\u54cd\u5e94\u5f0f\u7f16\u8f91"],"Effortlessly customize block settings for different devices using a single, intuitive control interface. Whether adjusting settings for each device individually or hovering over elements, you can instantly see the changes in an active preview.":["\u4f7f\u7528\u5355\u4e00\u76f4\u89c2\u7684\u63a7\u5236\u754c\u9762\uff0c\u8f7b\u677e\u4e3a\u4e0d\u540c\u8bbe\u5907\u81ea\u5b9a\u4e49 block \u8bbe\u7f6e\u3002\u65e0\u8bba\u662f\u5355\u72ec\u8c03\u6574\u6bcf\u4e2a\u8bbe\u5907\u7684\u8bbe\u7f6e\uff0c\u8fd8\u662f\u60ac\u505c\u5728\u5143\u7d20\u4e0a\uff0c\u60a8\u90fd\u53ef\u4ee5\u5728\u5b9e\u65f6\u9884\u89c8\u4e2d\u7acb\u5373\u770b\u5230\u66f4\u6539\u6548\u679c\u3002"],"Integrated Unsplash Images":["\u96c6\u6210 Unsplash \u56fe\u7247"],"Nectarblocks seamlessly integrates with Unsplash to provide you with a vast library of high quality images to choose from.":["Nectarblocks \u4e0e Unsplash \u65e0\u7f1d\u96c6\u6210\uff0c\u4e3a\u60a8\u63d0\u4f9b\u6d77\u91cf\u4f18\u8d28\u56fe\u7247\u4f9b\u9009\u62e9\u3002"],"The title font used in the live demo is \"Kyrlon\" by Tom Karlsson and can be ":["\u6f14\u793a\u7ad9\u70b9\u4e2d\u4f7f\u7528\u7684\u6807\u9898\u5b57\u4f53\u662fTom Karlsson\u8bbe\u8ba1\u7684\"Kyrlon\"\u5b57\u4f53\uff0c\u53ef\u4ee5"],"downloaded here.":["\u5728\u6b64\u4e0b\u8f7d\u3002"],"Demo Content":["\u6f14\u793a\u5185\u5bb9"],"Theme Options":["\u4e3b\u9898\u9009\u9879"],"Global Settings":["\u5168\u5c40\u8bbe\u7f6e"],"Widgets":["\u5c0f\u5de5\u5177"],"The duration of prebuilt website imports can vary. Ensure that your server":["\u9884\u5efa\u7f51\u7ad9\u5bfc\u5165\u6240\u9700\u65f6\u95f4\u53ef\u80fd\u4f1a\u6709\u6240\u4e0d\u540c\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u670d\u52a1\u5668"],"fulfills all necessary requirements":["\u6ee1\u8db3\u6240\u6709\u5fc5\u8981\u8981\u6c42"],"Warning: This demo requires":["\u8b66\u544a\uff1a\u6b64\u6f14\u793a\u9700\u8981"],"but the plugin is not currently active in your setup.":["\u4f46\u8be5\u63d2\u4ef6\u5f53\u524d\u5728\u60a8\u7684\u8bbe\u7f6e\u4e2d\u5e76\u672a\u6fc0\u6d3b\u3002"],"Successfully imported demo.":["\u6210\u529f\u5bfc\u5165\u6f14\u793a\u3002"],"Failed to import demo.":["\u5bfc\u5165\u6f14\u793a\u5931\u8d25\u3002"],"Import Demo":["\u5bfc\u5165\u6f14\u793a"],"You are not using the included":["\u60a8\u672a\u4f7f\u7528\u968f\u9644\u7684"],"Nectarblocks theme":["Nectarblocks \u4e3b\u9898"],", which is recommended for demo imports.":["\uff0c\u5efa\u8bae\u7528\u4e8e\u5bfc\u5165\u6f14\u793a\u5185\u5bb9\u3002"],"Export":["\u5bfc\u51fa"],"Export all":["\u5bfc\u51fa\u5168\u90e8"],"from Nectarblocks.":["\u6765\u81ea Nectarblocks\u3002"],"Your export will include the following data:":["\u60a8\u7684\u5bfc\u51fa\u5c06\u5305\u542b\u4ee5\u4e0b\u6570\u636e\uff1a"],"Global Colors":["\u5168\u5c40\u989c\u8272"],"Global Typography":["\u5168\u5c40\u6392\u7248"],"Global Custom Code":["\u5168\u5c40\u81ea\u5b9a\u4e49\u4ee3\u7801"],"Failed to export plugin settings.":["\u5bfc\u51fa\u63d2\u4ef6\u8bbe\u7f6e\u5931\u8d25\u3002"],"Successfully exported plugin settings.":["\u63d2\u4ef6\u8bbe\u7f6e\u5bfc\u51fa\u6210\u529f\u3002"],"Successfully imported plugin settings.":["\u6210\u529f\u5bfc\u5165\u63d2\u4ef6\u8bbe\u7f6e\u3002"],"Failed to import plugin settings.":["\u5bfc\u5165\u63d2\u4ef6\u8bbe\u7f6e\u5931\u8d25\u3002"],"Nectarblocks Settings":["Nectarblocks \u8bbe\u7f6e"],"Theme Customizer Settings":["Theme Customizer \u8bbe\u7f6e"],"General Settings":["\u5e38\u89c4\u8bbe\u7f6e"],"Typography Settings":["\u6392\u7248\u8bbe\u7f6e"],"Layout Settings":["\u5e03\u5c40\u8bbe\u7f6e"],"Post Types Settings":["\u6587\u7ae0\u7c7b\u578b\u8bbe\u7f6e"],"General WordPress Page Settings":["WordPress \u9875\u9762\u5e38\u89c4\u8bbe\u7f6e"],"Failed to export customizer settings.":["\u5bfc\u51fa\u81ea\u5b9a\u4e49\u5668\u8bbe\u7f6e\u5931\u8d25\u3002"],"Successfully exported customizer settings.":["\u6210\u529f\u5bfc\u51fa\u81ea\u5b9a\u4e49\u5668\u8bbe\u7f6e\u3002"],"Successfully imported customizer settings.":["\u6210\u529f\u5bfc\u5165\u81ea\u5b9a\u4e49\u5668\u8bbe\u7f6e\u3002"],"Failed to import customizer settings.":["\u5bfc\u5165\u81ea\u5b9a\u4e49\u5668\u8bbe\u7f6e\u5931\u8d25\u3002"],"Nectarblocks Theme Customizer Settings":["Nectarblocks \u4e3b\u9898\u5b9a\u5236\u5668\u8bbe\u7f6e"],"Please authorize Nectarblocks with your license key to access the Demo Importer. That can be done in Authorization tab in the Admin Panel.":["\u8bf7\u5728\u7ba1\u7406\u9762\u677f\u7684\u6388\u6743\u6807\u7b7e\u9875\u4e2d\u4f7f\u7528\u60a8\u7684\u8bb8\u53ef\u8bc1\u5bc6\u94a5\u6388\u6743 Nectarblocks\uff0c\u4ee5\u8bbf\u95ee\u6f14\u793a\u5bfc\u5165\u5668\u3002"],"You must install the Nectarblocks Importer\/Exporter plugin to access the Demo Importer.":["\u60a8\u5fc5\u987b\u5b89\u88c5 Nectarblocks Importer\/Exporter \u63d2\u4ef6\u624d\u80fd\u8bbf\u95ee\u6f14\u793a\u5bfc\u5165\u5668\u3002"],"Demos":["\u6f14\u793a"],"Theme Customizer":["\u4e3b\u9898\u5b9a\u5236\u5668"],"Portfolio Post Type":["\u4f5c\u54c1\u96c6\u6587\u7ae0\u7c7b\u578b"],"Registers a post type for Portfolio projects.":["\u4e3a Portfolio \u9879\u76ee\u6ce8\u518c\u4e00\u4e2a post type\u3002"],"Default Text Block":["\u9ed8\u8ba4\u6587\u672c\u533a\u5757"],"Choose the default text block used when typing in an empty paragraph.":["\u9009\u62e9\u5728\u7a7a\u6bb5\u843d\u4e2d\u8f93\u5165\u65f6\u4f7f\u7528\u7684\u9ed8\u8ba4\u6587\u672c block\u3002"],"Nectarblocks Text":["Nectarblocks \u6587\u672c"],"Core Paragraph":["\u6838\u5fc3\u6bb5\u843d"],"Hide Page Titles":["\u9690\u85cf\u9875\u9762\u6807\u9898"],"Hide titles by default on all pages.":["\u9ed8\u8ba4\u5728\u6240\u6709\u9875\u9762\u4e0a\u9690\u85cf\u6807\u9898\u3002"],"Disable Core Typography Rules":["\u7981\u7528\u6838\u5fc3\u6392\u7248\u89c4\u5219"],"Disable the core ":["\u7981\u7528\u6838\u5fc3\u529f\u80fd"]," rules to allow your theme to control typography, rather than Nectarblocks.":["\u5141\u8bb8\u60a8\u7684\u4e3b\u9898\u63a7\u5236\u6392\u7248\uff0c\u800c\u4e0d\u662f\u7531 Nectarblocks \u63a7\u5236\u3002"],"Getting Started":["\u5f00\u59cb\u4f7f\u7528"],"Authorization":["\u6388\u6743"],"Plugin Options":["\u63d2\u4ef6\u9009\u9879"],"Custom Code":["\u81ea\u5b9a\u4e49\u4ee3\u7801"],"Custom Fonts":["\u81ea\u5b9a\u4e49\u5b57\u4f53"],"Modules":["\u6a21\u5757"],"Import\/Export":["\u5bfc\u5165\/\u5bfc\u51fa"],"Documentation":["\u6587\u6863"],"Unknown Color":["\u672a\u77e5\u989c\u8272"],"Unexpected error during activation.":["\u6fc0\u6d3b\u8fc7\u7a0b\u4e2d\u53d1\u751f\u610f\u5916\u9519\u8bef\u3002"],"Unexpected error during deactivation.":["\u505c\u7528\u671f\u95f4\u53d1\u751f\u610f\u5916\u9519\u8bef\u3002"],"Enter your Nectarblocks":["\u8f93\u5165\u60a8\u7684 Nectarblocks"],"Enter the name of your font":["\u8f93\u5165\u60a8\u7684\u5b57\u4f53\u540d\u79f0"],"for a successful import. Once the import process begins, please refrain from refreshing the page until it has completed.":["\u4ee5\u786e\u4fdd\u6210\u529f\u5bfc\u5165\u3002\u5bfc\u5165\u8fc7\u7a0b\u5f00\u59cb\u540e\uff0c\u8bf7\u52ff\u5237\u65b0\u9875\u9762\uff0c\u76f4\u5230\u5bfc\u5165\u5b8c\u6210\u3002"],"Global Settings are primarily located in the right-hand side of the editor when clicking on the Nectarblocks logo, and a few are contained in this options panel.":["\u5168\u5c40\u8bbe\u7f6e\u4e3b\u8981\u4f4d\u4e8e\u7f16\u8f91\u5668\u53f3\u4fa7\uff0c\u70b9\u51fb Nectarblocks \u6807\u5fd7\u5373\u53ef\u8bbf\u95ee\uff0c\u5c11\u6570\u8bbe\u7f6e\u5305\u542b\u5728\u6b64\u9009\u9879\u9762\u677f\u4e2d\u3002"],"Import a nectarblocks_plugin.json here to restore a previously exported set of Global Settings.":["\u5728\u6b64\u5bfc\u5165 nectarblocks_plugin.json \u6587\u4ef6\u4ee5\u6062\u590d\u4e4b\u524d\u5bfc\u51fa\u7684\u5168\u5c40\u8bbe\u7f6e\u3002"],"Theme Customizer settings are available in the WordPress Customizer (Appearance \u2192 Customize) and handle all the general styling for the Nectarblocks theme.":["\u4e3b\u9898\u81ea\u5b9a\u4e49\u8bbe\u7f6e\u53ef\u5728 WordPress \u81ea\u5b9a\u4e49\u5de5\u5177\uff08\u5916\u89c2 \u2192 \u81ea\u5b9a\u4e49\uff09\u4e2d\u627e\u5230\uff0c\u7528\u4e8e\u5904\u7406 Nectarblocks \u4e3b\u9898\u7684\u6240\u6709\u5e38\u89c4\u6837\u5f0f\u3002"],"Import a nectarblocks_theme.json here to restore a previously exported set of Theme Customizer Settings.":["\u5728\u6b64\u5bfc\u5165 nectarblocks_theme.json \u6587\u4ef6\u4ee5\u6062\u590d\u4e4b\u524d\u5bfc\u51fa\u7684\u4e3b\u9898\u81ea\u5b9a\u4e49\u8bbe\u7f6e\u3002"]}}}