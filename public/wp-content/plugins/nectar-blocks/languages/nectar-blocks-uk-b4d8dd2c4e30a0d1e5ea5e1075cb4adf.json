u0430\u0446\u044c\u043a\u0438\u0439 \u0448\u0440\u0438\u0444\u0442."],"Import":["\u0406\u043c\u043f\u043e\u0440\u0442"],"Welcome to the future of WordPress":["\u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0434\u043e \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u0433\u043e WordPress"],"Nectarblocks elevates the WordPress Gutenberg editor to an exceptionally powerful editor. Explore the key features below to begin your journey.":["Nectarblocks \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u044e\u0454 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 WordPress Gutenberg \u043d\u0430 \u043d\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043d\u043e \u043f\u043e\u0442\u0443\u0436\u043d\u0438\u0439 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f. \u041e\u0437\u043d\u0430\u0439\u043e\u043c\u0442\u0435\u0441\u044f \u0437 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u044f\u043c\u0438 \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u043f\u043e\u0434\u043e\u0440\u043e\u0436."],"Block Collection":["\u041a\u043e\u043b\u0435\u043a\u0446\u0456\u044f \u0431\u043b\u043e\u043a\u0456\u0432"],"A robust collection of powerful blocks designed to simplify the process of building your website.":["\u041d\u0430\u0434\u0456\u0439\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f \u043f\u043e\u0442\u0443\u0436\u043d\u0438\u0445 \u0431\u043b\u043e\u043a\u0456\u0432, \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0445 \u0434\u043b\u044f \u0441\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0443 \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u0412\u0430\u0448\u043e\u0433\u043e \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0443."],"The Template Library":["\u0411\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a\u0430 \u0448\u0430\u0431\u043b\u043e\u043d\u0456\u0432"],"Jump start your Website creation with our professionally designed collection of pre-made templates":["\u041f\u0440\u0438\u0441\u043a\u043e\u0440\u0442\u0435 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0412\u0430\u0448\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0443 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043d\u0430\u0448\u043e\u0457 \u043f\u0440\u043e\u0444\u0435\u0441\u0456\u0439\u043d\u043e \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u0435\u043d\u043e\u0457 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u0457 \u0433\u043e\u0442\u043e\u0432\u0438\u0445 \u0448\u0430\u0431\u043b\u043e\u043d\u0456\u0432"],"Streamlined Global Settings":["\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u043e\u0432\u0430\u043d\u0456 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Establish reusable color schemes and typography rules that can be effortlessly applied to Nectar blocks across all your pages.":["\u0421\u0442\u0432\u043e\u0440\u044e\u0439\u0442\u0435 \u0433\u043e\u0442\u043e\u0432\u0456 \u043a\u043e\u043b\u0456\u0440\u043d\u0456 \u0441\u0445\u0435\u043c\u0438 \u0442\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0456 \u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u044f\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u043b\u0435\u0433\u043a\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0434\u043e \u0431\u043b\u043e\u043a\u0456\u0432 Nectar \u043d\u0430 \u0432\u0441\u0456\u0445 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430\u0445 \u0412\u0430\u0448\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0443."],"Extensively Customizable Block Settings":["\u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432, \u0449\u043e \u0433\u043d\u0443\u0447\u043a\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f"],"Experience unparalleled control with our extensively customizable block settings. Tailor each element to your unique design requirements.":["\u041e\u0442\u0440\u0438\u043c\u0430\u0439\u0442\u0435 \u0431\u0435\u0437\u043f\u0440\u0435\u0446\u0435\u0434\u0435\u043d\u0442\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u043d\u0430\u0448\u0438\u043c \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u043c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0431\u043b\u043e\u043a\u0456\u0432. \u041d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043a\u043e\u0436\u0435\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0432\u0430\u0448\u0438\u0445 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440\u0441\u044c\u043a\u0438\u0445 \u0432\u0438\u043c\u043e\u0433."],"Next-Gen Responsive Editing":["\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u0437 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u0438\u043c \u0434\u0438\u0437\u0430\u0439\u043d\u043e\u043c"],"Effortlessly customize block settings for different devices using a single, intuitive control interface. Whether adjusting settings for each device individually or hovering over elements, you can instantly see the changes in an active preview.":["\u041b\u0435\u0433\u043a\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0431\u043b\u043e\u043a\u0430 \u0434\u043b\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0454\u0434\u0438\u043d\u043e\u0433\u043e \u0456\u043d\u0442\u0443\u0457\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f. \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0442\u043e\u0433\u043e, \u0447\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0454\u0442\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e \u043e\u043a\u0440\u0435\u043c\u043e, \u0447\u0438 \u043d\u0430\u0432\u043e\u0434\u0438\u0442\u0435 \u043a\u0443\u0440\u0441\u043e\u0440 \u043d\u0430 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438, \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043c\u0438\u0442\u0442\u0454\u0432\u043e \u0431\u0430\u0447\u0438\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0456."],"Integrated Unsplash Images":["\u0406\u043d\u0442\u0435\u0433\u0440\u043e\u0432\u0430\u043d\u0456 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f Unsplash"],"Nectarblocks seamlessly integrates with Unsplash to provide you with a vast library of high quality images to choose from.":["Nectarblocks \u043b\u0435\u0433\u043a\u043e \u0456\u043d\u0442\u0435\u0433\u0440\u0443\u0454\u0442\u044c\u0441\u044f \u0437 Unsplash, \u0449\u043e\u0431 \u043d\u0430\u0434\u0430\u0442\u0438 \u0412\u0430\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0457 \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a\u0438 \u0432\u0438\u0441\u043e\u043a\u043e\u044f\u043a\u0456\u0441\u043d\u0438\u0445 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u043d\u0430 \u0432\u0438\u0431\u0456\u0440."],"The title font used in the live demo is \"Kyrlon\" by Tom Karlsson and can be ":["\u0428\u0440\u0438\u0444\u0442 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0456\u0432, \u044f\u043a\u0438\u0439 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0443 \u0436\u0438\u0432\u043e\u043c\u0443 \u0434\u0435\u043c\u043e - \u0446\u0435 \"Kyrlon\" \u0432\u0456\u0434 Tom Karlsson \u0456 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438"],"downloaded here.":["\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e \u0442\u0443\u0442."],"Demo Content":["\u0414\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u0439\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442"],"Theme Options":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0435\u043c\u0438"],"Global Settings":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Widgets":["\u0412\u0456\u0434\u0436\u0435\u0442\u0438"],"The duration of prebuilt website imports can vary. Ensure that your server":["\u0422\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u0456\u043c\u043f\u043e\u0440\u0442\u0443 \u0433\u043e\u0442\u043e\u0432\u0438\u0445 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0456\u0432 \u043c\u043e\u0436\u0435 \u0432\u0456\u0434\u0440\u0456\u0437\u043d\u044f\u0442\u0438\u0441\u044f. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0412\u0430\u0448 \u0441\u0435\u0440\u0432\u0435\u0440"],"fulfills all necessary requirements":["\u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0432\u0441\u0456\u043c \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u043c \u0432\u0438\u043c\u043e\u0433\u0430\u043c"],"Warning: This demo requires":["\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f: \u0426\u044f \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454"],"but the plugin is not currently active in your setup.":["\u0430\u043b\u0435 \u043f\u043b\u0430\u0433\u0456\u043d \u043d\u0430\u0440\u0430\u0437\u0456 \u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043e\u0432\u0430\u043d\u0438\u0439 \u0443 \u0412\u0430\u0448\u0456\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0456."],"Successfully imported demo.":["\u0414\u0435\u043c\u043e \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e."],"Failed to import demo.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0434\u0435\u043c\u043e."],"Import Demo":["\u0406\u043c\u043f\u043e\u0440\u0442 \u0434\u0435\u043c\u043e"],"You are not using the included":["\u0412\u0438 \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u0435 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0443 "],"Nectarblocks theme":["\u0422\u0435\u043c\u0430 Nectarblocks"],", which is recommended for demo imports.":[", \u0449\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u0443 \u0434\u0435\u043c\u043e-\u0434\u0430\u043d\u0438\u0445."],"Export":["\u0415\u043a\u0441\u043f\u043e\u0440\u0442"],"Export all":["\u0415\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0435"],"from Nectarblocks.":["\u0432\u0456\u0434 Nectarblocks."],"Your export will include the following data:":["\u0412\u0430\u0448 \u0435\u043a\u0441\u043f\u043e\u0440\u0442 \u043c\u0456\u0441\u0442\u0438\u0442\u0438\u043c\u0435 \u0442\u0430\u043a\u0456 \u0434\u0430\u043d\u0456:"],"Global Colors":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0456 \u043a\u043e\u043b\u044c\u043e\u0440\u0438"],"Global Typography":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u0430"],"Global Custom Code":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0438\u0439 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0438\u0439 \u043a\u043e\u0434"],"Failed to export plugin settings.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043b\u0430\u0433\u0456\u043d\u0430."],"Successfully exported plugin settings.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043b\u0430\u0433\u0456\u043d\u0430 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e."],"Successfully imported plugin settings.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043b\u0430\u0433\u0456\u043d\u0430 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e."],"Failed to import plugin settings.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043b\u0430\u0433\u0456\u043d\u0430."],"Nectarblocks Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Nectarblocks"],"Theme Customizer Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430 \u0442\u0435\u043c\u0438"],"General Settings":["\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Typography Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u0438"],"Layout Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0430\u043a\u0435\u0442\u0443"],"Post Types Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0438\u043f\u0456\u0432 \u0437\u0430\u043f\u0438\u0441\u0456\u0432"],"General WordPress Page Settings":["\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 WordPress"],"Failed to export customizer settings.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430."],"Successfully exported customizer settings.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430 \u0442\u0435\u043c\u0438 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e."],"Successfully imported customizer settings.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430 \u0442\u0435\u043c\u0438 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e."],"Failed to import customizer settings.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430."],"Nectarblocks Theme Customizer Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430 \u0442\u0435\u043c\u0438 Nectarblocks"],"Please authorize Nectarblocks with your license key to access the Demo Importer. That can be done in Authorization tab in the Admin Panel.":["\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0439\u0442\u0435 Nectarblocks \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0412\u0430\u0448\u043e\u0433\u043e \u043b\u0456\u0446\u0435\u043d\u0437\u0456\u0439\u043d\u043e\u0433\u043e \u043a\u043b\u044e\u0447\u0430 \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u043e Demo Importer. \u0426\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0443 \u0432\u043a\u043b\u0430\u0434\u0446\u0456 \u0410\u0432\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0456\u044f \u0432 Admin Panel."],"You must install the Nectarblocks Importer\/Exporter plugin to access the Demo Importer.":["\u0414\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u043e Demo Importer \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u043f\u043b\u0430\u0433\u0456\u043d Nectarblocks Importer\/Exporter."],"Demos":["\u0414\u0435\u043c\u043e"],"Theme Customizer":["\u041d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447 \u0442\u0435\u043c\u0438"],"Portfolio Post Type":["\u0422\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0456\u0432 \u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0456\u043e"],"Registers a post type for Portfolio projects.":["\u0420\u0435\u0454\u0441\u0442\u0440\u0443\u0454 \u0442\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0443 \u0434\u043b\u044f \u043f\u0440\u043e\u0454\u043a\u0442\u0456\u0432 \u043f\u043e\u0440\u0442\u0444\u043e\u043b\u0456\u043e."],"Default Text Block":["\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u0439 \u0431\u043b\u043e\u043a"],"Choose the default text block used when typing in an empty paragraph.":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0431\u043b\u043e\u043a \u0442\u0435\u043a\u0441\u0442\u0443 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c, \u044f\u043a\u0438\u0439 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u043c\u0435\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u0456 \u0442\u0435\u043a\u0441\u0442\u0443 \u0432 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0439 \u043f\u0430\u0440\u0430\u0433\u0440\u0430\u0444."],"Nectarblocks Text":["\u0422\u0435\u043a\u0441\u0442 Nectarblocks"],"Core Paragraph":["\u041e\u0441\u043d\u043e\u0432\u043d\u0438\u0439 \u041f\u0430\u0440\u0430\u0433\u0440\u0430\u0444"],"Hide Page Titles":["\u041f\u0440\u0438\u0445\u043e\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043e\u043a"],"Hide titles by default on all pages.":["\u041f\u0440\u0438\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043d\u0430 \u0432\u0441\u0456\u0445 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430\u0445."],"Disable Core Typography Rules":["\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u0457"],"Disable the core ":["\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u044f\u0434\u0440\u043e"]," rules to allow your theme to control typography, rather than Nectarblocks.":["\u043f\u0440\u0430\u0432\u0438\u043b\u0430, \u044f\u043a\u0456 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442\u044c \u0412\u0430\u0448\u0456\u0439 \u0442\u0435\u043c\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e\u0432\u0430\u0442\u0438 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u0443 \u0437\u0430\u043c\u0456\u0441\u0442\u044c Nectarblocks."],"Getting Started":["\u041f\u043e\u0447\u0430\u0442\u043e\u043a \u0440\u043e\u0431\u043e\u0442\u0438"],"Authorization":["\u0410\u0432\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0456\u044f"],"Plugin Options":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043b\u0430\u0433\u0456\u043d\u0430"],"Custom Code":["\u0412\u043b\u0430\u0441\u043d\u0438\u0439 \u043a\u043e\u0434"],"Custom Fonts":["\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0456 \u0448\u0440\u0438\u0444\u0442\u0438"],"Modules":["\u041c\u043e\u0434\u0443\u043b\u0456"],"Import\/Export":["\u0406\u043c\u043f\u043e\u0440\u0442\/\u0415\u043a\u0441\u043f\u043e\u0440\u0442"],"Documentation":["\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0456\u044f"],"Unknown Color":["\u041d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u043a\u043e\u043b\u0456\u0440"],"Unexpected error during activation.":["\u041d\u0435\u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u0457."],"Unexpected error during deactivation.":["\u041d\u0435\u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0434\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u0457."],"Enter your Nectarblocks":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0412\u0430\u0448 Nectarblocks"],"Enter the name of your font":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443 \u0412\u0430\u0448\u043e\u0433\u043e \u0448\u0440\u0438\u0444\u0442\u0443"],"for a successful import. Once the import process begins, please refrain from refreshing the page until it has completed.":["\u0434\u043b\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u043e\u0433\u043e \u0456\u043c\u043f\u043e\u0440\u0442\u0443. \u041f\u0456\u0441\u043b\u044f \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0443 \u0456\u043c\u043f\u043e\u0440\u0442\u0443, \u0431\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0443\u0442\u0440\u0438\u043c\u0430\u0439\u0442\u0435\u0441\u044f \u0432\u0456\u0434 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0434\u043e \u0439\u043e\u0433\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f."],"Global Settings are primarily located in the right-hand side of the editor when clicking on the Nectarblocks logo, and a few are contained in this options panel.":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c\u0443 \u0440\u043e\u0437\u0442\u0430\u0448\u043e\u0432\u0430\u043d\u0456 \u0432 \u043f\u0440\u0430\u0432\u0456\u0439 \u0447\u0430\u0441\u0442\u0438\u043d\u0456 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430 \u043f\u0440\u0438 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u0456 \u043d\u0430 \u043b\u043e\u0433\u043e\u0442\u0438\u043f Nectarblocks, \u0430 \u0434\u0435\u044f\u043a\u0456 \u043c\u0456\u0441\u0442\u044f\u0442\u044c\u0441\u044f \u0432 \u0446\u0456\u0439 \u043f\u0430\u043d\u0435\u043b\u0456 \u043e\u043f\u0446\u0456\u0439."],"Import a nectarblocks_plugin.json here to restore a previously exported set of Global Settings.":["\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 nectarblocks_plugin.json \u0442\u0443\u0442, \u0449\u043e\u0431 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0440\u0430\u043d\u0456\u0448\u0435 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0438\u0439 \u043d\u0430\u0431\u0456\u0440 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0438\u0445 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c."],"Theme Customizer settings are available in the WordPress Customizer (Appearance \u2192 Customize) and handle all the general styling for the Nectarblocks theme.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430 \u0442\u0435\u043c\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0456 WordPress (\u0412\u0438\u0433\u043b\u044f\u0434 \u2192 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438) \u0456 \u043a\u0435\u0440\u0443\u044e\u0442\u044c \u0443\u0441\u0456\u043c \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u043c \u0441\u0442\u0438\u043b\u0435\u043c \u0442\u0435\u043c\u0438 Nectarblocks."],"Import a nectarblocks_theme.json here to restore a previously exported set of Theme Customizer Settings.":["\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 nectarblocks_theme.json \u0441\u044e\u0434\u0438, \u0449\u043e\u0431 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0440\u0430\u043d\u0456\u0448\u0435 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0438\u0439 \u043d\u0430\u0431\u0456\u0440 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u0447\u0430 \u0442\u0435\u043c\u0438."]}}}