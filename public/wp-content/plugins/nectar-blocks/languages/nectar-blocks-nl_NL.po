#. Plugin Name of the plugin
#: nectar-blocks.php includes/Editor/Blocks.php:737 build/editor.js:1
msgid "Nectarblocks"
msgstr "Nectarblocks"

#. Description of the plugin
#: nectar-blocks.php
msgid ""
"Step into the future of WordPress with Nectarblocks, where innovation meets "
"seamless design. Unleash the full potential of your website by transforming "
"the core WordPress editor into a dynamic and robust full-site editor."
msgstr ""
"Stap in de toekomst van WordPress met Nectarblocks, waar innovatie en "
"naadloos ontwerp samenkomen. Ontgrendel het volledige potentieel van je "
"website door de kern WordPress-editor te transformeren in een dynamische en "
"robuuste full-site editor."

