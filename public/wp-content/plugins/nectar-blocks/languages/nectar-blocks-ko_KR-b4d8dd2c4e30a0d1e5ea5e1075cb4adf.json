4 \uc131\uacf5\uc801\uc73c\ub85c \ub0b4\ubcf4\ub0c8\uc2b5\ub2c8\ub2e4."],"Successfully imported plugin settings.":["\ud50c\ub7ec\uadf8\uc778 \uc124\uc815\uc744 \uc131\uacf5\uc801\uc73c\ub85c \uac00\uc838\uc654\uc2b5\ub2c8\ub2e4."],"Failed to import plugin settings.":["\ud50c\ub7ec\uadf8\uc778 \uc124\uc815 \uac00\uc838\uc624\uae30\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4."],"Nectarblocks Settings":["Nectarblocks \uc124\uc815"],"Theme Customizer Settings":["\ud14c\ub9c8 Customizer \uc124\uc815"],"General Settings":["\uc77c\ubc18 \uc124\uc815"],"Typography Settings":["\ud0c0\uc774\ud3ec\uadf8\ub798\ud53c \uc124\uc815"],"Layout Settings":["\ub808\uc774\uc544\uc6c3 \uc124\uc815"],"Post Types Settings":["\uae00 \uc720\ud615 \uc124\uc815"],"General WordPress Page Settings":["WordPress \ud398\uc774\uc9c0 \uc77c\ubc18 \uc124\uc815"],"Failed to export customizer settings.":["Customizer \uc124\uc815\uc744 \ub0b4\ubcf4\ub0b4\ub294 \ub370 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4."],"Successfully exported customizer settings.":["\ucee4\uc2a4\ud130\ub9c8\uc774\uc800 \uc124\uc815\uc744 \uc131\uacf5\uc801\uc73c\ub85c \ub0b4\ubcf4\ub0c8\uc2b5\ub2c8\ub2e4."],"Successfully imported customizer settings.":["\ucee4\uc2a4\ud130\ub9c8\uc774\uc800 \uc124\uc815\uc744 \uc131\uacf5\uc801\uc73c\ub85c \uac00\uc838\uc654\uc2b5\ub2c8\ub2e4."],"Failed to import customizer settings.":["\uc0ac\uc6a9\uc790 \uc815\uc758 \uc124\uc815\uc744 \uac00\uc838\uc624\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."],"Nectarblocks Theme Customizer Settings":["Nectarblocks \ud14c\ub9c8 \ucee4\uc2a4\ud130\ub9c8\uc774\uc800 \uc124\uc815"],"Please authorize Nectarblocks with your license key to access the Demo Importer. That can be done in Authorization tab in the Admin Panel.":["Demo Importer\uc5d0 \uc811\uadfc\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub77c\uc774\uc120\uc2a4 \ud0a4\ub85c Nectarblocks\ub97c \uc778\uc99d\ud574\uc57c \ud569\ub2c8\ub2e4. Admin Panel\uc758 Authorization \ud0ed\uc5d0\uc11c \uc778\uc99d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."],"You must install the Nectarblocks Importer\/Exporter plugin to access the Demo Importer.":["Demo Importer\uc5d0 \uc811\uadfc\ud558\ub824\uba74 Nectarblocks Importer\/Exporter \ud50c\ub7ec\uadf8\uc778\uc744 \uc124\uce58\ud574\uc57c \ud569\ub2c8\ub2e4."],"Demos":["\ub370\ubaa8"],"Theme Customizer":["\ud14c\ub9c8 \ucee4\uc2a4\ud130\ub9c8\uc774\uc800"],"Portfolio Post Type":["\ud3ec\ud2b8\ud3f4\ub9ac\uc624 \uae00 \uc720\ud615"],"Registers a post type for Portfolio projects.":["Portfolio \ud504\ub85c\uc81d\ud2b8\ub97c \uc704\ud55c post type\uc744 \ub4f1\ub85d\ud569\ub2c8\ub2e4."],"Default Text Block":["\uae30\ubcf8 \ud14d\uc2a4\ud2b8 \ube14\ub85d"],"Choose the default text block used when typing in an empty paragraph.":["\ube48 \ub2e8\ub77d\uc5d0 \uc785\ub825\ud560 \ub54c \uc0ac\uc6a9\ud560 \uae30\ubcf8 \ud14d\uc2a4\ud2b8 block\uc744 \uc120\ud0dd\ud558\uc138\uc694."],"Nectarblocks Text":["Nectarblocks Text"],"Core Paragraph":["\uae30\ubcf8 \ubb38\ub2e8"],"Hide Page Titles":["\ud398\uc774\uc9c0 \uc81c\ubaa9 \uc228\uae30\uae30"],"Hide titles by default on all pages.":["\ubaa8\ub4e0 \ud398\uc774\uc9c0\uc5d0\uc11c \uae30\ubcf8\uc801\uc73c\ub85c \uc81c\ubaa9 \uc228\uae30\uae30."],"Disable Core Typography Rules":["Core Typography \uaddc\uce59 \ube44\ud65c\uc131\ud654"],"Disable the core ":["\ucf54\uc5b4 \ube44\ud65c\uc131\ud654"]," rules to allow your theme to control typography, rather than Nectarblocks.":["\ud14c\ub9c8\uac00 Nectarblocks\uac00 \uc544\ub2cc \ud0c0\uc774\ud3ec\uadf8\ub798\ud53c\ub97c \uc81c\uc5b4\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\ub294 \uaddc\uce59."],"Getting Started":["\uc2dc\uc791\ud558\uae30"],"Authorization":["\uc778\uc99d"],"Plugin Options":["\ud50c\ub7ec\uadf8\uc778 \uc635\uc158"],"Custom Code":["\ucee4\uc2a4\ud140 \ucf54\ub4dc"],"Modules":["\ubaa8\ub4c8"],"Import\/Export":["\uac00\uc838\uc624\uae30\/\ub0b4\ubcf4\ub0b4\uae30"],"Documentation":["\ubb38\uc11c"],"Unknown Color":["\uc54c \uc218 \uc5c6\ub294 \uc0c9\uc0c1"],"Unexpected error during activation.":["\ud65c\uc131\ud654 \uc911 \uc608\uae30\uce58 \uc54a\uc740 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4."],"Unexpected error during deactivation.":["\ube44\ud65c\uc131\ud654 \uc911 \uc608\uae30\uce58 \uc54a\uc740 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4."],"Enter your Nectarblocks":["Nectarblocks\ub97c \uc785\ub825\ud558\uc138\uc694"],"Enter the name of your font":["\ud3f0\ud2b8 \uc774\ub984\uc744 \uc785\ub825\ud558\uc138\uc694"],"Global Settings are primarily located in the right-hand side of the editor when clicking on the Nectarblocks logo, and a few are contained in this options panel.":["\uc804\uc5ed \uc124\uc815\uc740 \uc8fc\ub85c Nectarblocks \ub85c\uace0\ub97c \ud074\ub9ad\ud588\uc744 \ub54c \ud3b8\uc9d1\uae30 \uc624\ub978\ucabd\uc5d0 \uc704\uce58\ud558\uba70, \uc77c\ubd80\ub294 \uc774 \uc635\uc158 \ud328\ub110\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."],"Import a nectarblocks_plugin.json here to restore a previously exported set of Global Settings.":["nectarblocks_plugin.json \ud30c\uc77c\uc744 \uc5ec\uae30\uc5d0 \uac00\uc838\uc640\uc11c \uc774\uc804\uc5d0 \ub0b4\ubcf4\ub0b8 \uc804\uc5ed \uc124\uc815\uc744 \ubcf5\uc6d0\ud558\uc138\uc694."],"Theme Customizer settings are available in the WordPress Customizer (Appearance \u2192 Customize) and handle all the general styling for the Nectarblocks theme.":["Theme Customizer \uc124\uc815\uc740 WordPress Customizer(\uc678\ubaa8 \u2192 \uc0ac\uc6a9\uc790 \uc815\uc758)\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70 Nectarblocks \ud14c\ub9c8\uc758 \ubaa8\ub4e0 \uc77c\ubc18 \uc2a4\ud0c0\uc77c\uc744 \ucc98\ub9ac\ud569\ub2c8\ub2e4."],"Import a nectarblocks_theme.json here to restore a previously exported set of Theme Customizer Settings.":["\uc774\uc804\uc5d0 \ub0b4\ubcf4\ub0b8 \ud14c\ub9c8 \uc0ac\uc6a9\uc790 \uc815\uc758 \uc124\uc815\uc744 \ubcf5\uc6d0\ud558\ub824\uba74 \uc5ec\uae30\uc5d0 nectarblocks_theme.json\uc744 \uac00\uc838\uc624\uc138\uc694."],"Group":["\uadf8\ub8f9"],"Cancel":["\ucde8\uc18c"],"Are you sure you want to delete":["\uc815\ub9d0 \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c"],"for a successful import. Once the import process begins,\n                please refrain from refreshing the page until it has completed.":["\uc131\uacf5\uc801\uc778 \uac00\uc838\uc624\uae30\ub97c \uc704\ud574\uc11c\uc785\ub2c8\ub2e4. \uac00\uc838\uc624\uae30 \uacfc\uc815\uc774 \uc2dc\uc791\ub418\uba74\n\uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \ud398\uc774\uc9c0\ub97c \uc0c8\ub85c\uace0\uce68\ud558\uc9c0 \ub9c8\uc138\uc694."],"Release notes":["\ub9b4\ub9ac\uc2a4 \ub178\ud2b8"],"Fonts":["\uae00\uaf34"],"License Key":["\ub77c\uc774\uc120\uc2a4 \ud0a4"],"Connected":["\uc5f0\uacb0\ub428"],"Refresh":["\uc0c8\ub85c\uace0\uce68"],"Adobe Fonts refreshed successfully.":["Adobe Fonts\ub97c \uc131\uacf5\uc801\uc73c\ub85c \uc0c8\ub85c\uace0\uce68\ud588\uc2b5\ub2c8\ub2e4."],"Failed to refresh Adobe Fonts.":["Adobe Fonts\ub97c \uc0c8\ub85c \uace0\uce60 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Disconnect":["\uc5f0\uacb0 \ud574\uc81c"],"No fonts found in your Adobe Fonts web projects. Add fonts at":["Adobe Fonts \uc6f9 \ud504\ub85c\uc81d\ud2b8\uc5d0\uc11c \uae00\uaf34\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uc5d0\uc11c \uae00\uaf34\uc744 \ucd94\uac00\ud558\uc138\uc694"],"Disconnect Adobe Fonts":["Adobe Fonts \uc5f0\uacb0 \ud574\uc81c"],"Are you sure you want to disconnect? Any typography settings using Adobe Fonts will need to be updated.":["Adobe Fonts\ub97c \uc0ac\uc6a9\ud558\ub294 \ubaa8\ub4e0 \ud0c0\uc774\ud3ec\uadf8\ub798\ud53c \uc124\uc815\uc744 \uc5c5\ub370\uc774\ud2b8\ud574\uc57c \ud569\ub2c8\ub2e4. \uc5f0\uacb0\uc744 \ud574\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"],"Disconnected from Adobe Fonts.":["Adobe Fonts \uc5f0\uacb0\uc774 \ud574\uc81c\ub418\uc5c8\uc2b5\ub2c8\ub2e4."],"Failed to disconnect from Adobe Fonts.":["Adobe Fonts \uc5f0\uacb0 \ud574\uc81c\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4."],"Connect your Adobe Fonts account to use your web fonts.":["Adobe Fonts \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc5ec \uc6f9 \ud3f0\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."],"Get your API token":["API \ud1a0\ud070 \ubc1b\uae30"],"Enter your Adobe Fonts API token...":["Adobe Fonts API \ud1a0\ud070\uc744 \uc785\ub825\ud558\uc138\uc694..."],"Connect":["\uc5f0\uacb0"],"Please enter your Adobe Fonts API token.":["Adobe Fonts API \ud1a0\ud070\uc744 \uc785\ub825\ud558\uc138\uc694."],"Successfully connected to Adobe Fonts.":["Adobe Fonts\uc5d0 \uc131\uacf5\uc801\uc73c\ub85c \uc5f0\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4."],"Failed to connect to Adobe Fonts.":["Adobe Fonts\uc5d0 \uc5f0\uacb0\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."],"Remove Variation":["\ubcc0\ud615 \uc81c\uac70"],"Delete Font":["\uae00\uaf34 \uc0ad\uc81c"],"Delete Font Variation":["\uae00\uaf34 \ubcc0\ud615 \uc0ad\uc81c"],"This will remove the font and all its variations.":["\uc774 \uc791\uc5c5\uc740 \uae00\uaf34\uacfc \ubaa8\ub4e0 \ubcc0\ud615\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4."],"Uploaded Fonts":["\uc5c5\ub85c\ub4dc\ub41c \uae00\uaf34"],"Adobe Fonts":["Adobe Fonts"],"Help":["\ub3c4\uc6c0\ub9d0"],"Blog Posts":["\ube14\ub85c\uadf8 \uae00"],"Portfolio Projects":["\ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ud504\ub85c\uc81d\ud2b8"],"Products":["\uc81c\ud488"],"Theme Builder Templates":["\ud14c\ub9c8 \ube4c\ub354 \ud15c\ud50c\ub9bf"],"Theme-level templates such as headers, footers, navigation, archive layouts, and single-post layouts that the demo pages depend on.":["\ub370\ubaa8 \ud398\uc774\uc9c0\uac00 \uc758\uc874\ud558\ub294 \uba38\ub9ac\uae00, \ubc14\ub2e5\uae00, \ub0b4\ube44\uac8c\uc774\uc158, \uc544\uce74\uc774\ube0c \ub808\uc774\uc544\uc6c3, \ub2e8\uc77c \uae00 \ub808\uc774\uc544\uc6c3\uacfc \uac19\uc740 \ud14c\ub9c8 \uc218\uc900 \ud15c\ud50c\ub9bf\uc785\ub2c8\ub2e4."],"Reusable section layouts inserted into pages, such as megamenu displays and shared content blocks.":["\ud398\uc774\uc9c0\uc5d0 \uc0bd\uc785\ub418\ub294 \uc7ac\uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc139\uc158 \ub808\uc774\uc544\uc6c3\uc73c\ub85c, \uba54\uac00\uba54\ub274 \ud45c\uc2dc \ubc0f \uacf5\uc720 \ucf58\ud150\uce20 \ube14\ub85d \ub4f1\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4."],"Forms":["\ud3fc"],"Fluent Forms used by demo pages (e.g. the contact form). Requires the Fluent Forms plugin.":["\ub370\ubaa8 \ud398\uc774\uc9c0\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 Fluent Forms(\uc608: \uc5f0\ub77d\ucc98 \ud3fc). Fluent Forms \ud50c\ub7ec\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."],"Include":["\ud3ec\ud568"],"Select all":["\ubaa8\ub450 \uc120\ud0dd"],"isn\u2019t installed.":["\uc774(\uac00) \uc124\uce58\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."],"Install":["\uc124\uce58"],"Local Google Fonts":["\ub85c\uceec Google Fonts"],"Automatically download and serve Google Fonts locally for improved performance and GDPR compliance.":["Google Fonts\ub97c \uc790\ub3d9\uc73c\ub85c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \ub85c\uceec\uc5d0\uc11c \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \uc131\ub2a5\uc744 \uac1c\uc120\ud558\uace0 GDPR\uc744 \uc900\uc218\ud569\ub2c8\ub2e4."],"Lazy Load Images":["\uc774\ubbf8\uc9c0 \uc9c0\uc5f0 \ub85c\ub529"],"Defer off-screen images until they are near the viewport, reducing initial page weight. Above-the-fold images are detected automatically and load eagerly.":["\ubdf0\ud3ec\ud2b8 \uadfc\ucc98\uc5d0 \ub3c4\ub2ec\ud560 \ub54c\uae4c\uc9c0 \ud654\uba74 \ubc16 \uc774\ubbf8\uc9c0 \ub85c\ub529\uc744 \uc9c0\uc5f0\ud558\uc5ec \ucd08\uae30 \ud398\uc774\uc9c0 \uc6a9\ub7c9\uc744 \uc904\uc785\ub2c8\ub2e4. \uc2a4\ud06c\ub864 \uc5c6\uc774 \ubcf4\uc774\ub294 \uc601\uc5ed\uc758 \uc774\ubbf8\uc9c0\ub294 \uc790\ub3d9\uc73c\ub85c \uac10\uc9c0\ub418\uc5b4 \uc989\uc2dc \ub85c\ub4dc\ub429\ub2c8\ub2e4."],"Nectarblocks 3.0 release artwork":["Nectarblocks 3.0 \ub9b4\ub9ac\uc2a4 \uc544\ud2b8\uc6cc\ud06c"],"What's New":["\uc0c8\ub85c\uc6b4 \uae30\ub2a5"],"Welcome to Nectarblocks 3.0":["Nectarblocks 3.0\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4"],"This release introduces a complete header builder, a faster editing experience, hover interactions with a reworked animation builder, a smarter design system, and a leaner front end, plus dozens of improvements to the blocks you use every day. Read on for the highlights, or jump straight in and start building.":["\uc774\ubc88 \ub9b4\ub9ac\uc2a4\uc5d0\uc11c\ub294 \uc644\uc804\ud55c \ud5e4\ub354 \ube4c\ub354, \ub354 \ube60\ub978 \ud3b8\uc9d1 \ud658\uacbd, \uc7ac\uc791\uc5c5\ub41c \uc560\ub2c8\uba54\uc774\uc158 \ube4c\ub354\ub97c \ud1b5\ud55c \ud638\ubc84 \uc778\ud130\ub799\uc158, \ub354 \uc2a4\ub9c8\ud2b8\ud55c \ub514\uc790\uc778 \uc2dc\uc2a4\ud15c, \ub354 \uac00\ubcbc\uc6b4 \ud504\ub860\ud2b8\uc5d4\ub4dc\ub97c \ub3c4\uc785\ud558\uba70, \ub9e4\uc77c \uc0ac\uc6a9\ud558\ub294 \ube14\ub85d\uc5d0 \ub300\ud55c \uc218\uc2ed \uac00\uc9c0 \uac1c\uc120 \uc0ac\ud56d\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc8fc\uc694 \ub0b4\uc6a9\uc744 \uacc4\uc18d \uc77d\uc5b4\ubcf4\uc2dc\uac70\ub098 \ubc14\ub85c \uc2dc\uc791\ud558\uc5ec \ube4c\ub4dc\ub97c \uc2dc\uc791\ud558\uc138\uc694."],"The header builder you\u2019ve always wanted":["\ud56d\uc0c1 \uc6d0\ud588\ub358 \ud5e4\ub354 \ube4c\ub354"],"Build custom site headers right in WordPress with flexible layouts, responsive controls, and unlimited states. Add search, navigation, overlay menus, and full megamenus.":["WordPress\uc5d0\uc11c \uc720\uc5f0\ud55c \ub808\uc774\uc544\uc6c3, \ubc18\uc751\ud615 \ucee8\ud2b8\ub864, \ubb34\uc81c\ud55c \uc0c1\ud0dc\ub85c \uc0ac\uc6a9\uc790 \uc815\uc758 \uc0ac\uc774\ud2b8 \uba38\ub9ac\uae00\uc744 \ubc14\ub85c \ub9cc\ub4dc\uc138\uc694. \uac80\uc0c9, \ub0b4\ube44\uac8c\uc774\uc158, \uc624\ubc84\ub808\uc774 \uba54\ub274, \uc804\uccb4 \uba54\uac00\uba54\ub274\ub97c \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."],"Header builder preview":["\ud5e4\ub354 \ube4c\ub354 \ubbf8\ub9ac\ubcf4\uae30"],"A faster editing experience":["\ub354 \ube60\ub978 \ud3b8\uc9d1 \ud658\uacbd"],"Reimagined spacing controls, drag-to-reorder layers, active-state indicators, and drag-to-reposition absolute elements. Settings are better organized, onboarding is clearer.":["\uac04\uaca9 \uc870\uc808 \uae30\ub2a5 \uac1c\uc120, \ub4dc\ub798\uadf8\ub85c \ub808\uc774\uc5b4 \uc21c\uc11c \ubcc0\uacbd, \ud65c\uc131 \uc0c1\ud0dc \ud45c\uc2dc, \ub4dc\ub798\uadf8\ub85c \uc808\ub300 \uc704\uce58 \uc694\uc18c \uc7ac\ubc30\uce58. \uc124\uc815\uc774 \ub354 \uc798 \uc815\ub9ac\ub418\uc5c8\uace0 \uc628\ubcf4\ub529\uc774 \ub354 \uba85\ud655\ud574\uc84c\uc2b5\ub2c8\ub2e4."],"Editor experience preview":["\ud3b8\uc9d1\uae30 \uacbd\ud5d8 \ubbf8\ub9ac\ubcf4\uae30"],"Hover interactions, reworked animation UI":["\ud638\ubc84 \uc778\ud130\ub799\uc158, \uac1c\uc120\ub41c \uc560\ub2c8\uba54\uc774\uc158 UI"],"A new interaction animation system brings limitless hover effects, with spring physics for natural motion, child-element staggering, and per-property timelines. The animation builder has been reworked throughout, with a live preview for every effect.":["\uc0c8\ub85c\uc6b4 \uc778\ud130\ub799\uc158 \uc560\ub2c8\uba54\uc774\uc158 \uc2dc\uc2a4\ud15c\uc740 \ubb34\ud55c\ud55c \ud638\ubc84 \ud6a8\uacfc\ub97c \uc81c\uacf5\ud558\uba70, \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc6c0\uc9c1\uc784\uc744 \uc704\ud55c \uc2a4\ud504\ub9c1 \ubb3c\ub9ac, \ud558\uc704 \uc694\uc18c \uc2dc\ucc28 \ud6a8\uacfc, \uc18d\uc131\ubcc4 \ud0c0\uc784\ub77c\uc778\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc560\ub2c8\uba54\uc774\uc158 \ube4c\ub354\uac00 \uc804\uba74 \uac1c\ud3b8\ub418\uc5b4 \ubaa8\ub4e0 \ud6a8\uacfc\uc5d0 \ub300\ud55c \uc2e4\uc2dc\uac04 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."],"Animation editor preview":["\uc560\ub2c8\uba54\uc774\uc158 \ud3b8\uc9d1\uae30 \ubbf8\ub9ac\ubcf4\uae30"],"A smarter design system":["\ub354 \uc2a4\ub9c8\ud2b8\ud55c \ub514\uc790\uc778 \uc2dc\uc2a4\ud15c"],"Manage typography and color in one place with Adobe Fonts integration, saved custom palettes, and a new color scale system that generates tonal variations for every palette color.":["Adobe Fonts \ud1b5\ud569, \uc800\uc7a5\ub41c \uc0ac\uc6a9\uc790 \uc815\uc758 \ud314\ub808\ud2b8, \ubaa8\ub4e0 \ud314\ub808\ud2b8 \uc0c9\uc0c1\uc5d0 \ub300\ud55c \uc0c9\uc870 \ubcc0\ud615\uc744 \uc0dd\uc131\ud558\ub294 \uc0c8\ub85c\uc6b4 \uc0c9\uc0c1 \uc2a4\ucf00\uc77c \uc2dc\uc2a4\ud15c\uc73c\ub85c \ud0c0\uc774\ud3ec\uadf8\ub798\ud53c\uc640 \uc0c9\uc0c1\uc744 \ud55c \uacf3\uc5d0\uc11c \uad00\ub9ac\ud558\uc138\uc694."],"Design system preview":["\ub514\uc790\uc778 \uc2dc\uc2a4\ud15c \ubbf8\ub9ac\ubcf4\uae30"],"Faster, leaner front end":["\ub354 \ube60\ub974\uace0 \uac00\ubcbc\uc6b4 \ud504\ub860\ud2b8\uc5d4\ub4dc"],"Pages ship cleaner markup with per-page CSS generation, locally served Google Fonts, image lazy loading, and selective script loading. The result is fewer network requests and faster load times for your visitors.":["\ud398\uc774\uc9c0\ubcc4 CSS \uc0dd\uc131, \ub85c\uceec \uc81c\uacf5 Google Fonts, \uc774\ubbf8\uc9c0 \uc9c0\uc5f0 \ub85c\ub529, \uc120\ud0dd\uc801 \uc2a4\ud06c\ub9bd\ud2b8 \ub85c\ub529\uc744 \ud1b5\ud574 \ud398\uc774\uc9c0\uac00 \ub354 \uae54\ub054\ud55c \ub9c8\ud06c\uc5c5\uc73c\ub85c \uc81c\uacf5\ub429\ub2c8\ub2e4. \uadf8 \uacb0\uacfc \ub124\ud2b8\uc6cc\ud06c \uc694\uccad\uc774 \uc904\uc5b4\ub4e4\uace0 \ubc29\ubb38\uc790\uc758 \ub85c\ub529 \uc2dc\uac04\uc774 \ube68\ub77c\uc9d1\ub2c8\ub2e4."],"Performance preview":["\uc131\ub2a5 \ubbf8\ub9ac\ubcf4\uae30"],"Powerful new blocks to build with":["\uac15\ub825\ud55c \uc0c8 \ube14\ub85d\uc73c\ub85c \uc81c\uc791\ud558\uc138\uc694"],"Build more without leaving the editor with a ticker for auto-scrolling loops, world time for timezones, an auto-generated table of contents, plus navigation, search, and header actions blocks.":["\uc790\ub3d9 \uc2a4\ud06c\ub864 \ub8e8\ud504\ub97c \uc704\ud55c \ud2f0\ucee4, \uc2dc\uac04\ub300\ub97c \uc704\ud55c \uc138\uacc4 \uc2dc\uac04, \uc790\ub3d9 \uc0dd\uc131 \ubaa9\ucc28, \uadf8\ub9ac\uace0 \ub0b4\ube44\uac8c\uc774\uc158, \uac80\uc0c9, \uba38\ub9ac\uae00 \uc561\uc158 \ube14\ub85d\uc73c\ub85c \ud3b8\uc9d1\uae30\ub97c \ub5a0\ub098\uc9c0 \uc54a\uace0 \ub354 \ub9ce\uc774 \uad6c\ucd95\ud558\uc138\uc694."],"New blocks preview":["\uc0c8 \ube14\ub85d \ubbf8\ub9ac\ubcf4\uae30"],"New templates and a ready-made demo":["\uc0c8\ub85c\uc6b4 \ud15c\ud50c\ub9bf\uacfc \ubc14\ub85c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ub370\ubaa8"],"Start faster with over 35 new pre-made templates, plus Radnor, a complete business website demo you can install in a click and make your own.":["35\uac1c \uc774\uc0c1\uc758 \uc0c8\ub85c\uc6b4 \uc0ac\uc804 \uc81c\uc791 \ud15c\ud50c\ub9bf\uacfc \ud074\ub9ad \ud55c \ubc88\uc73c\ub85c \uc124\uce58\ud558\uc5ec \ub098\ub9cc\uc758 \uc0ac\uc774\ud2b8\ub85c \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc644\uc804\ud55c \ube44\uc988\ub2c8\uc2a4 \uc6f9\uc0ac\uc774\ud2b8 \ub370\ubaa8\uc778 Radnor\ub85c \ub354 \ube60\ub974\uac8c \uc2dc\uc791\ud558\uc138\uc694."],"Templates and demo preview":["\ud15c\ud50c\ub9bf \ubc0f \ub370\ubaa8 \ubbf8\ub9ac\ubcf4\uae30"],"Changelog":["\ubcc0\uacbd \ub0b4\uc5ed"],"More in this release":["\uc774\ubc88 \ub9b4\ub9ac\uc2a4\uc758 \ucd94\uac00 \ub0b4\uc6a9"],"Over 90 new features, improvements, and fixes for building better WordPress websites. Explore the full 3.0 release for every detail.":["90\uac1c \uc774\uc0c1\uc758 \uc0c8\ub85c\uc6b4 \uae30\ub2a5, \uac1c\uc120 \uc0ac\ud56d \ubc0f \uc218\uc815 \uc0ac\ud56d\uc73c\ub85c \ub354 \ub098\uc740 WordPress \uc6f9\uc0ac\uc774\ud2b8\ub97c \uad6c\ucd95\ud558\uc138\uc694. \ubaa8\ub4e0 \uc138\ubd80 \uc815\ubcf4\ub294 \uc804\uccb4 3.0 \ub9b4\ub9ac\uc2a4\ub97c \ud655\uc778\ud558\uc138\uc694."],"Explore Nectarblocks 3.0":["Nectarblocks 3.0 \uc0b4\ud3b4\ubcf4\uae30"],"Version":["\ubc84\uc804"]}}}