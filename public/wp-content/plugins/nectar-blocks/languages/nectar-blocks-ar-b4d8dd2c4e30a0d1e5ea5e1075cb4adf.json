643 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0633\u062a\u0648\u0631\u062f \u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a\u0629. \u064a\u0645\u0643\u0646 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0630\u0644\u0643 \u0641\u064a \u062a\u0628\u0648\u064a\u0628 \u0627\u0644\u062a\u0641\u0648\u064a\u0636 \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629."],"You must install the Nectarblocks Importer\/Exporter plugin to access the Demo Importer.":["\u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u062a\u062b\u0628\u064a\u062a \u0625\u0636\u0627\u0641\u0629 Nectarblocks Importer\/Exporter \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0633\u062a\u0648\u0631\u062f \u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a\u0629."],"Demos":["\u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0627\u062a"],"Theme Customizer":["\u0645\u062e\u0635\u0635 \u0627\u0644\u0642\u0627\u0644\u0628"],"Portfolio Post Type":["\u0646\u0648\u0639 \u0645\u0646\u0634\u0648\u0631 \u0627\u0644\u0645\u062d\u0641\u0638\u0629"],"Registers a post type for Portfolio projects.":["\u064a\u064f\u0633\u062c\u0644 \u0646\u0648\u0639 \u0645\u062d\u062a\u0648\u0649 \u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u062d\u0641\u0638\u0629."],"Default Text Block":["\u0645\u0631\u0628\u0639 \u0627\u0644\u0646\u0635 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a"],"Choose the default text block used when typing in an empty paragraph.":["\u0627\u062e\u062a\u0631 \u0643\u062a\u0644\u0629 \u0627\u0644\u0646\u0635 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0639\u0646\u062f \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u064a \u0641\u0642\u0631\u0629 \u0641\u0627\u0631\u063a\u0629."],"Nectarblocks Text":["Nectarblocks Text"],"Core Paragraph":["\u0627\u0644\u0641\u0642\u0631\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629"],"Hide Page Titles":["\u0625\u062e\u0641\u0627\u0621 \u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0644\u0635\u0641\u062d\u0627\u062a"],"Hide titles by default on all pages.":["\u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0627\u064b \u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u0635\u0641\u062d\u0627\u062a."],"Disable Core Typography Rules":["\u062a\u0639\u0637\u064a\u0644 \u0642\u0648\u0627\u0639\u062f Typography \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629"],"Disable the core ":["\u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u0646\u0648\u0627\u0629"]," rules to allow your theme to control typography, rather than Nectarblocks.":["\u0642\u0648\u0627\u0639\u062f \u0644\u0644\u0633\u0645\u0627\u062d \u0644\u0642\u0627\u0644\u0628\u0643 \u0628\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0637\u0628\u0627\u0639\u0629\u060c \u0628\u062f\u0644\u0627\u064b \u0645\u0646 Nectarblocks."],"Getting Started":["\u0627\u0644\u0628\u062f\u0621"],"Authorization":["\u0627\u0644\u062a\u0641\u0648\u064a\u0636"],"Plugin Options":["\u062e\u064a\u0627\u0631\u0627\u062a Plugin"],"Custom Code":["\u0643\u0648\u062f \u0645\u062e\u0635\u0635"],"Custom Fonts":["\u0627\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u0645\u062e\u0635\u0635\u0629"],"Modules":["\u0627\u0644\u0648\u062d\u062f\u0627\u062a"],"Import\/Export":["\u0627\u0633\u062a\u064a\u0631\u0627\u062f\/\u062a\u0635\u062f\u064a\u0631"],"Documentation":["\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629"],"Unknown Color":["\u0644\u0648\u0646 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641"],"Unexpected error during activation.":["\u062e\u0637\u0623 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0641\u0639\u064a\u0644."],"Unexpected error during deactivation.":["\u062e\u0637\u0623 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639 \u0623\u062b\u0646\u0627\u0621 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0641\u0639\u064a\u0644."],"Enter your Nectarblocks":["\u0623\u062f\u062e\u0644 Nectarblocks \u0627\u0644\u062e\u0627\u0635 \u0628\u0643"],"Enter the name of your font":["\u0623\u062f\u062e\u0644 \u0627\u0633\u0645 \u0627\u0644\u062e\u0637 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643"],"for a successful import. Once the import process begins, please refrain from refreshing the page until it has completed.":["\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0646\u0627\u062c\u062d. \u0628\u0645\u062c\u0631\u062f \u0628\u062f\u0621 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u0645\u062a\u0646\u0627\u0639 \u0639\u0646 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u0641\u062d\u0629 \u062d\u062a\u0649 \u062a\u0643\u062a\u0645\u0644."],"Global Settings are primarily located in the right-hand side of the editor when clicking on the Nectarblocks logo, and a few are contained in this options panel.":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0639\u0627\u0645\u0629 \u0645\u0648\u062c\u0648\u062f\u0629 \u0628\u0634\u0643\u0644 \u0623\u0633\u0627\u0633\u064a \u0641\u064a \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0645\u0646 \u0645\u0646 \u0627\u0644\u0645\u062d\u0631\u0631 \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0634\u0639\u0627\u0631 Nectarblocks\u060c \u0648\u0628\u0639\u0636\u0647\u0627 \u0645\u0648\u062c\u0648\u062f \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0647\u0630\u0647."],"Import a nectarblocks_plugin.json here to restore a previously exported set of Global Settings.":["\u0627\u0633\u062a\u0648\u0631\u062f \u0645\u0644\u0641 nectarblocks_plugin.json \u0647\u0646\u0627 \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u0645\u064f\u0635\u062f\u0651\u0631\u0629 \u0645\u0633\u0628\u0642\u064b\u0627."],"Theme Customizer settings are available in the WordPress Customizer (Appearance \u2192 Customize) and handle all the general styling for the Nectarblocks theme.":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062e\u0635\u0635 \u0627\u0644\u0642\u0627\u0644\u0628 \u0645\u062a\u0627\u062d\u0629 \u0641\u064a \u0645\u062e\u0635\u0635 WordPress (\u0627\u0644\u0645\u0638\u0647\u0631 \u2190 \u062a\u062e\u0635\u064a\u0635) \u0648\u062a\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u0646\u0633\u064a\u0642\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0642\u0627\u0644\u0628 Nectarblocks."],"Import a nectarblocks_theme.json here to restore a previously exported set of Theme Customizer Settings.":["\u0627\u0633\u062a\u0648\u0631\u062f \u0645\u0644\u0641 nectarblocks_theme.json \u0647\u0646\u0627 \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062e\u0635\u0635 \u0644\u0644\u0642\u0627\u0644\u0628 \u0627\u0644\u0645\u064f\u0635\u062f\u064e\u0651\u0631\u0629 \u0645\u0633\u0628\u0642\u064b\u0627."]}}}