649 \u0645\u062d\u0631\u0631 \u0641\u0627\u0626\u0642 \u0627\u0644\u0642\u0648\u0629. \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0623\u062f\u0646\u0627\u0647 \u0644\u062a\u0628\u062f\u0623 \u0631\u062d\u0644\u062a\u0643."],"Block Collection":["\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0643\u062a\u0644"],"A robust collection of powerful blocks designed to simplify the process of building your website.":["\u0645\u062c\u0645\u0648\u0639\u0629 \u0642\u0648\u064a\u0629 \u0645\u0646 \u0643\u062a\u0644 \u0645\u0635\u0645\u0645\u0629 \u0644\u062a\u0628\u0633\u064a\u0637 \u0639\u0645\u0644\u064a\u0629 \u0628\u0646\u0627\u0621 \u0645\u0648\u0642\u0639\u0643 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a."],"The Template Library":["\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0642\u0648\u0627\u0644\u0628"],"Jump start your Website creation with our professionally designed collection of pre-made templates":["\u0627\u0628\u062f\u0623 \u0625\u0646\u0634\u0627\u0621 \u0645\u0648\u0642\u0639\u0643 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0628\u0633\u0631\u0639\u0629 \u0645\u0639 \u0645\u062c\u0645\u0648\u0639\u062a\u0646\u0627 \u0645\u0646 \u0627\u0644\u0642\u0648\u0627\u0644\u0628 \u0627\u0644\u062c\u0627\u0647\u0632\u0629 \u0627\u0644\u0645\u0635\u0645\u0645\u0629 \u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0627\u064b"],"Streamlined Global Settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0639\u0627\u0645\u0629 \u0645\u0628\u0633\u0637\u0629"],"Establish reusable color schemes and typography rules that can be effortlessly applied to Nectar blocks across all your pages.":["\u0623\u0646\u0634\u0626 \u0623\u0646\u0638\u0645\u0629 \u0623\u0644\u0648\u0627\u0646 \u0648\u0642\u0648\u0627\u0639\u062f \u0637\u0628\u0627\u0639\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u064a\u0645\u0643\u0646 \u062a\u0637\u0628\u064a\u0642\u0647\u0627 \u0628\u0633\u0647\u0648\u0644\u0629 \u0639\u0644\u0649 \u0643\u062a\u0644 Nectar \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0635\u0641\u062d\u0627\u062a\u0643."],"Extensively Customizable Block Settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0643\u062a\u0644\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062e\u0635\u064a\u0635 \u0628\u0634\u0643\u0644 \u0645\u0648\u0633\u0639"],"Experience unparalleled control with our extensively customizable block settings. Tailor each element to your unique design requirements.":["\u0627\u062e\u062a\u0628\u0631 \u062a\u062d\u0643\u0645\u064b\u0627 \u0644\u0627 \u0645\u062b\u064a\u0644 \u0644\u0647 \u0645\u0639 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0643\u062a\u0644\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062e\u0635\u064a\u0635 \u0639\u0644\u0649 \u0646\u0637\u0627\u0642 \u0648\u0627\u0633\u0639. \u0635\u0645\u0645 \u0643\u0644 \u0639\u0646\u0635\u0631 \u0648\u0641\u0642\u064b\u0627 \u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0641\u0631\u064a\u062f\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643."],"Next-Gen Responsive Editing":["\u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u062a\u062c\u0627\u0648\u0628 \u0645\u0646 \u0627\u0644\u062c\u064a\u0644 \u0627\u0644\u0642\u0627\u062f\u0645"],"Effortlessly customize block settings for different devices using a single, intuitive control interface. Whether adjusting settings for each device individually or hovering over elements, you can instantly see the changes in an active preview.":["\u062e\u0635\u0651\u0635 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0643\u062a\u0644\u0629 \u0628\u0633\u0647\u0648\u0644\u0629 \u0644\u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u062c\u0647\u0629 \u062a\u062d\u0643\u0645 \u0648\u0627\u062d\u062f\u0629 \u0648\u0628\u062f\u064a\u0647\u064a\u0629. \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u062a\u0639\u062f\u0651\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u0643\u0644 \u062c\u0647\u0627\u0632 \u0639\u0644\u0649 \u062d\u062f\u0629 \u0623\u0648 \u062a\u062d\u0648\u0645 \u0641\u0648\u0642 \u0627\u0644\u0639\u0646\u0627\u0635\u0631\u060c \u064a\u0645\u0643\u0646\u0643 \u0631\u0624\u064a\u0629 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0641\u0648\u0631\u064b\u0627 \u0641\u064a \u0645\u0639\u0627\u064a\u0646\u0629 \u0646\u0634\u0637\u0629."],"Integrated Unsplash Images":["\u0635\u0648\u0631 Unsplash \u0627\u0644\u0645\u062f\u0645\u062c\u0629"],"Nectarblocks seamlessly integrates with Unsplash to provide you with a vast library of high quality images to choose from.":["\u064a\u062a\u0643\u0627\u0645\u0644 Nectarblocks \u0628\u0633\u0644\u0627\u0633\u0629 \u0645\u0639 Unsplash \u0644\u062a\u0632\u0648\u064a\u062f\u0643 \u0628\u0645\u0643\u062a\u0628\u0629 \u0636\u062e\u0645\u0629 \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0644\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646\u0647\u0627."],"The title font used in the live demo is \"Kyrlon\" by Tom Karlsson and can be ":["\u0627\u0644\u062e\u0637 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0641\u064a \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0647\u0648 \"Kyrlon\" \u0645\u0646 \u062a\u0635\u0645\u064a\u0645 Tom Karlsson \u0648"],"downloaded here.":["\u062a\u0645 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0647\u0646\u0627."],"Demo Content":["\u0645\u062d\u062a\u0648\u0649 \u062a\u062c\u0631\u064a\u0628\u064a"],"Theme Options":["\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0642\u0627\u0644\u0628"],"Global Settings":["\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629"],"Widgets":["\u0648\u062f\u062c\u0627\u062a"],"The duration of prebuilt website imports can vary. Ensure that your server":["\u0642\u062f \u062a\u062e\u062a\u0644\u0641 \u0645\u062f\u0629 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u062c\u0627\u0647\u0632\u0629. \u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u062e\u0627\u062f\u0645 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643"],"fulfills all necessary requirements":["\u064a\u0641\u064a \u0628\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0644\u0627\u0632\u0645\u0629"],"Warning: This demo requires":["\u062a\u062d\u0630\u064a\u0631: \u0647\u0630\u0627 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a \u064a\u062a\u0637\u0644\u0628"],"but the plugin is not currently active in your setup.":["\u0648\u0644\u0643\u0646 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u063a\u064a\u0631 \u0645\u0641\u0639\u0644\u0629 \u062d\u0627\u0644\u064a\u0627\u064b \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0643."],"Successfully imported demo.":["\u062a\u0645 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a \u0628\u0646\u062c\u0627\u062d."],"Failed to import demo.":["\u0641\u0634\u0644 \u0641\u064a \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a."],"Import Demo":["\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a"],"You are not using the included":["\u0623\u0646\u062a \u0644\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 "],"Nectarblocks theme":["\u062b\u064a\u0645 Nectarblocks"],", which is recommended for demo imports.":["\u060c \u0648\u0647\u0648 \u0627\u0644\u0645\u064f\u0648\u0635\u0649 \u0628\u0647 \u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629."],"Export":["\u062a\u0635\u062f\u064a\u0631"],"Export all":["\u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0643\u0644"],"from Nectarblocks.":["\u0645\u0646 Nectarblocks."],"Your export will include the following data:":["\u0633\u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629:"],"Global Colors":["\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u0639\u0627\u0645\u0629"],"Global Typography":["\u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0639\u0627\u0645 \u0644\u0644\u062e\u0637\u0648\u0637"],"Global Custom Code":["\u0627\u0644\u0643\u0648\u062f \u0627\u0644\u0645\u062e\u0635\u0635 \u0627\u0644\u0639\u0627\u0645"],"Failed to export plugin settings.":["\u0641\u0634\u0644 \u062a\u0635\u062f\u064a\u0631 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629."],"Successfully exported plugin settings.":["\u062a\u0645 \u062a\u0635\u062f\u064a\u0631 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0628\u0646\u062c\u0627\u062d."],"Successfully imported plugin settings.":["\u062a\u0645 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0628\u0646\u062c\u0627\u062d."],"Failed to import plugin settings.":["\u0641\u0634\u0644 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629."],"Nectarblocks Settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a Nectarblocks"],"Theme Customizer Settings":["\u0625\u0639